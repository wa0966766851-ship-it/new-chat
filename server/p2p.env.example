# 雙人連線部署範例。將實際值設於主機環境，請勿提交金鑰。
SEER_P2P_HOST=127.0.0.1
SEER_P2P_PORT=3091
# 若前端與信令共用網址，來源會由服務自動比對。
# 不同網址才填入前端完整來源。
SEER_P2P_PUBLIC_ORIGIN=
SEER_P2P_ORIGINS=
# 公開服務使用自己的 TURN。搭配 coturn use-auth-secret。
SEER_P2P_TURN_URLS=
SEER_P2P_TURN_SECRET=
# 同機驗證可暫設 1；公開版本預設保持關閉。
SEER_P2P_ALLOW_DIRECT=0
SEER_P2P_STUN_URLS=
# 編譯期選用；前端與信令同來源時可留空。
VITE_SEER_P2P_ORIGIN=
